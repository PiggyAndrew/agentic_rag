# Deepseek API Key
DEEPSEEK_API_KEY=sk-7582a5657fc042519669979db6cabd71

# 应用环境：development 或 production（不区分大小写）
# 当未显式设置 EMBEDDING_BACKEND 时：
#  - production → 使用 dashscope
#  - 其他环境 → 使用 ollama
APP_ENV=development

# LangSmith API Key
LANGSMITH_API_KEY="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"

# Embedding Backend 使用Ollama：ollama;使用阿里百炼使用：dashscope
# 可选项：若设置则优先级高于 APP_ENV 的自动选择
EMBEDDING_BACKEND=dashscope
# Ollama Embedding模型
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding
# 阿里百炼Embedding模型
DASHSCOPE_API_KEY=sk-7576587807914f3db18eaa1787704614
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBED_MODEL=text-embedding-v4
DASHSCOPE_MAX_INPUT_LEN=8192

# 是否开启知识库Rerank
KB_RERANK=true
KB_RERANK_MODEL=qllama/bge-reranker-v2-m3


# 是否开启文档解析时使用LLM识别目录
INGEST_USE_LLM_HEADING=true
# 数据库路径
SQL_DB_PATH=sqlite:///./data/sql/demo.db

# 控制日志级别
LOG_LEVEL=INFO
# 控制是否输出到控制台（1/true/yes 为开启）
LOG_TO_CONSOLE=1
# 文件日志位置
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
